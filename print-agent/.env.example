# Copie este arquivo para .env e preencha os valores.

# URL do backend. Local: http://localhost:3000
# Produção: a URL do serviço no Render (depois do deploy).
API_BASE_URL="http://localhost:3000"

# Precisa ser EXATAMENTE igual ao PRINT_AGENT_API_KEY configurado no backend.
PRINT_AGENT_API_KEY=""

# A cada quantos milissegundos o agente pergunta ao backend se tem pedido novo.
POLL_INTERVAL_MS=8000

# "console" = não usa impressora nenhuma, só mostra o cupom no terminal.
#             Útil pra testar o agente inteiro sem ter a impressora em mãos.
# "windows" = imprime de verdade, mandando os bytes pra impressora térmica
#             instalada no Windows (veja o README.md pra configurar isso).
PRINT_MODE="console"

# Nome EXATO da impressora, como aparece em "Configurações > Impressoras e
# scanners" do Windows. Só é usado quando PRINT_MODE="windows".
PRINTER_NAME=""

# Quantos caracteres cabem numa linha do cupom.
# 32 = bobina de 58mm (a mais comum/barata)
# 42 a 48 = bobina de 80mm
PRINTER_COLS=32
