# Copie este arquivo para .env e preencha os valores.

# String de conexão com o Postgres.
# Local (docker-compose): postgresql://eric:eric@localhost:5432/eric_burger?schema=public
# Neon (produção): use a connection string "pooled" do painel da Neon.
DATABASE_URL=""

# Só necessária em produção com Neon: connection string "direct" (sem pooling),
# usada apenas para rodar as migrations (prisma migrate deploy).
DIRECT_URL=""

# Token fixo que o agente de impressão usa pra se autenticar no backend.
# Gere um valor aleatório forte (ex: openssl rand -hex 32) antes de ir pra produção.
PRINT_AGENT_API_KEY=""

# Origens permitidas no CORS — a URL do front (Vercel em produção, localhost
# em dev). Aceita mais de uma separada por vírgula, para o caso de o projeto
# na Vercel responder por mais de um domínio:
# FRONTEND_URL="https://eric-burger.pages.dev"
FRONTEND_URL="http://localhost:5173"

# Token da AwesomeAPI, usada pra descobrir as coordenadas do CEP no cálculo
# da taxa de entrega. Gratuito (100 mil consultas/mês), em awesomeapi.com.br.
#
# Em desenvolvimento dá pra deixar em branco: sem token a cota é contada por
# IP, e o IP de uma máquina pessoal costuma dar conta.
#
# EM PRODUÇÃO ELE É OBRIGATÓRIO. Em hospedagem compartilhada (Render, e a
# maioria das outras) o IP de saída é dividido com outros serviços e já
# chega com a cota estourada — a consulta devolve HTTP 429 na primeira
# tentativa e nenhuma entrega consegue ser calculada.
AWESOMEAPI_TOKEN=""

PORT=3000
